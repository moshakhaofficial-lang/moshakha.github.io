---
import AffiliateButton from './AffiliateButton.astro';

export interface Props {
  asin: string | null;
  productName: string;
  price?: string;
}
const { asin, productName, price } = Astro.props;
---
{asin && (
  <>
    <aside class="buybar" id="buybar" aria-label="Quick buy" data-state="hidden">
      <div class="buybar-info">
        <p class="buybar-name">{productName}</p>
        {price && <span class="chip">{price}</span>}
      </div>
      <AffiliateButton asin={asin} productName={productName} label="Check price" position="sticky-bar" compact />
    </aside>
    <script>
      // Phones only (CSS hides the bar elsewhere). Slides in once the reader is
      // past the first buy button; tucks away while any other buy button is on
      // screen or the footer is reached.
      const bar = document.getElementById('buybar');
      if (bar) {
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>('main a[data-affiliate], .site-footer'),
        ).filter((el) => !bar.contains(el));
        const first = targets.find((el) => el.matches('a[data-affiliate]'));
        if (first) {
          // Plain scroll measurement rather than IntersectionObserver: a dozen
          // rect reads per frame is trivial, and it behaves the same in every
          // browser and embedded webview.
          const onScreen = (el: HTMLElement) => {
            const r = el.getBoundingClientRect();
            return r.bottom > 0 && r.top < window.innerHeight;
          };
          let queued = false;
          const update = () => {
            queued = false;
            const pastFirst = first.getBoundingClientRect().bottom < 0;
            bar.dataset.state = pastFirst && !targets.some(onScreen) ? 'shown' : 'hidden';
          };
          const schedule = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
          };
          window.addEventListener('scroll', schedule, { passive: true });
          window.addEventListener('resize', schedule);
          update();
        }
      }
    </script>
    <style is:global>
      .buybar { display: none; }
      @media (max-width: 46rem) {
        body { padding-bottom: calc(5rem + env(safe-area-inset-bottom)); }
        .buybar {
          display: flex; align-items: center; gap: .75rem;
          position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
          padding: .65rem 1rem calc(.65rem + env(safe-area-inset-bottom));
          background: rgba(17, 19, 25, .94);
          -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
          border-top: 1px solid var(--rule-hard);
          box-shadow: 0 -18px 40px -20px rgba(0, 0, 0, .8);
          transform: translateY(100%); visibility: hidden;
          transition: transform .28s ease, visibility 0s linear .28s;
        }
        .buybar[data-state="shown"] {
          transform: none; visibility: visible; transition: transform .28s ease, visibility 0s;
        }
        .buybar-info { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: .2rem; }
        .buybar-name {
          margin: 0; width: 100%; font-weight: 700; font-size: .95rem; line-height: 1.2;
          white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .buybar .chip { font-size: .72rem; padding: .05rem .55rem; }
        .buybar .btn--buy { flex: none; min-height: 2.75rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .buybar, .buybar[data-state="shown"] { transition: none; }
      }
    </style>
  </>
)}
