---
export interface Props { value: number; }
const { value } = Astro.props;
const rounded = Math.round(value * 2) / 2;
---
<span class="rating" role="img" aria-label={`${value} out of 5`}>
  <span class="stars" aria-hidden="true">
    {[1, 2, 3, 4, 5].map((i) => (
      <span class:list={['star', { full: rounded >= i, half: rounded === i - 0.5 }]}>&#9733;</span>
    ))}
  </span>
  <b>{value.toFixed(1)}</b>
</span>

<style>
  .rating { display: inline-flex; align-items: center; gap: .45rem; font-size: .92rem; }
  .rating b { font-family: var(--mono); font-weight: 500; font-size: .82rem; }
  .stars { display: inline-flex; letter-spacing: .05em; }
  .star { color: var(--rule); }
  .star.full { color: var(--signal); }
  .star.half { background: linear-gradient(90deg, var(--signal) 50%, var(--rule) 50%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .rating b { color: var(--ink); }
</style>
