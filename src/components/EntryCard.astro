---
import { Image } from 'astro:assets';
import Rating from './Rating.astro';
import type { CardImage } from '../lib/entry-image';

export interface Props {
  href: string;
  title: string;
  description?: string;
  label?: string;
  image?: CardImage;
  date?: Date;
  rating?: number;
  /** Scroll-reveal animation (grids only — never inside horizontal rails). */
  reveal?: boolean;
  /** Smaller type for carousels such as "Keep reading". */
  compact?: boolean;
}
const { href, title, description, label, image = null, date, rating, reveal = false, compact = false } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<article class:list={['ecard', { reveal, compact }]}>
  {image && (
    <div class="ecard-img">
      <Image
        src={image.src}
        alt={image.alt}
        widths={[320, 480, 640]}
        sizes="(max-width: 46rem) 85vw, 20rem"
        format="webp"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="ecard-body">
    {label && <p class="ecard-label">{label}</p>}
    <h3><a href={href}>{title}</a></h3>
    {description && <p class="ecard-desc">{description}</p>}
    {(rating !== undefined || date) && (
      <p class="ecard-meta">
        {rating !== undefined && <Rating value={rating} />}
        {date && <time class="meta" datetime={date.toISOString()}>{fmt(date)}</time>}
      </p>
    )}
  </div>
</article>

<style>
  .ecard {
    position: relative; display: flex; flex-direction: column; overflow: hidden;
    background: linear-gradient(180deg, var(--surface), var(--paper-2));
    border: 1px solid var(--rule); border-radius: var(--r);
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .ecard:hover {
    border-color: rgba(255, 106, 43, .55); transform: translateY(-3px);
    box-shadow: 0 18px 40px -18px var(--signal-glow);
  }
  .ecard-img { aspect-ratio: 16 / 10; background: var(--paper-2); overflow: hidden; }
  .ecard-img :global(img) {
    width: 100%; height: 100%; object-fit: cover; border-radius: 0;
    transition: transform .4s ease;
  }
  .ecard:hover .ecard-img :global(img) { transform: scale(1.04); }
  .ecard-body { padding: 1.15rem 1.3rem 1.35rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  .ecard-label { font-weight: 650; font-size: .85rem; color: var(--signal); margin: 0; }
  .ecard h3 { font-size: 1.15rem; margin: 0; letter-spacing: -.02em; line-height: 1.2; }
  .ecard h3 a { color: var(--ink); text-decoration: none; }
  /* Whole card is the link target. */
  .ecard h3 a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .ecard h3 a:focus-visible { outline: none; }
  .ecard:has(h3 a:focus-visible) { outline: 2px solid var(--signal); outline-offset: 3px; }
  .ecard:hover h3 a { color: var(--signal); }
  .ecard-desc {
    margin: 0; color: var(--ink-2); font-size: .95rem;
    display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ecard-meta { margin: auto 0 0; padding-top: .3rem; display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; }
  .compact .ecard-body { padding: 1rem 1.1rem 1.15rem; }
  .compact h3 { font-size: 1.05rem; }
</style>
