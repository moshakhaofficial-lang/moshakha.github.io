---
import { getCollection } from 'astro:content';
import EntryCard from './EntryCard.astro';
import { entryImage, COLLECTION_LABEL } from '../lib/entry-image';

export interface Props {
  /** "collection/slug" references, e.g. 'guides/best-microfiber-towels'. */
  related: string[];
  currentId: string;
}
const { related, currentId } = Astro.props;

const all = (
  await Promise.all(
    (['guides', 'how-to', 'reviews', 'blog'] as const).map(async (c) => {
      const entries = await getCollection(c).catch(() => []);
      return entries.map((e) => ({ ...e, ref: `${c}/${e.id}` }));
    }),
  )
).flat();

// Resolve explicit refs; silently skip ones that don't exist yet so a typo
// in frontmatter never breaks the build.
const resolved = related
  .map((ref) => all.find((e) => e.ref === ref))
  .filter((e) => e && !e.data.draft && e.ref !== currentId);

// Backfill with recent articles so every page has outbound internal links.
const fallback = all
  .filter((e) => !e.data.draft && e.ref !== currentId && !resolved.some((r) => r!.ref === e.ref))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate);

// Nine, not six: at three, every related ref declared beyond the third was
// silently dropped, which left ~a third of the site with no in-body inbound
// links at all. Nine fills three clean rows of the 3-column grid and surfaces the
// cross-links the articles already declare.
const items = [...resolved, ...fallback].slice(0, 9);
---
{items.length > 0 && (
  <aside class="related" aria-labelledby="related-heading">
    <h2 id="related-heading">Keep reading</h2>
    <div class="grid grid--3 related-grid">
      {items.map((e) => (
        <EntryCard
          compact
          href={`/${e!.ref}/`}
          title={e!.data.title}
          label={COLLECTION_LABEL[e!.collection]}
          image={entryImage(e!)}
        />
      ))}
    </div>
  </aside>
)}

<style>
  .related { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--rule); }
  .related-grid { margin-top: 1.25rem; }
  /* Phones: one swipeable row instead of nine stacked cards. */
  @media (max-width: 46rem) {
    .related-grid {
      display: flex; gap: .9rem; overflow-x: auto; overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
      margin-inline: -1.4rem; padding: .4rem 1.4rem 1rem; scroll-padding-inline: 1.4rem;
      scrollbar-width: thin; scrollbar-color: var(--rule-hard) transparent;
    }
    .related-grid > :global(*) { flex: 0 0 76%; scroll-snap-align: start; }
  }
</style>
