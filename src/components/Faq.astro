---
export interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently asked questions</h2>
    <div class="faq-list">
      {items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <div class="faq-answer"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq { margin-top: 3rem; }
  .faq-list { margin-top: 1.25rem; border: 1px solid var(--rule); border-radius: var(--r); overflow: hidden; }
  details + details { border-top: 1px solid var(--rule); }
  summary {
    cursor: pointer; padding: 1rem 1.15rem; font-weight: 650; list-style: none;
    display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-weight: 400; font-size: 1.4rem; line-height: 1; color: var(--ink-3); flex-shrink: 0; }
  details[open] summary::after { content: "\2212"; }
  summary:hover { background: var(--paper-2); }
  .faq-answer { padding: 0 1.15rem 1.15rem; color: var(--ink-2); }
</style>
