---
import Rating from './Rating.astro';
import AffiliateButton from './AffiliateButton.astro';
export interface Props {
  picks: { rank: number; name: string; brand: string; award: string; asin: string | null; rating: number; gsm?: string; price?: string; bestFor: string }[];
  note?: string;
}
const { picks, note } = Astro.props;
const showGsm = picks.some((p) => p.gsm);
const showPrice = picks.some((p) => p.price);
---
{picks.length > 0 && (
  <section class="compare breakout" aria-labelledby="compare-heading">
    <h2 id="compare-heading">At a glance</h2>
    {note && <p class="compare-note">{note}</p>}
    <div class="table-scroll">
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col">Product</th>
            <th scope="col">Award</th>
            {showGsm && <th scope="col">GSM</th>}
            {showPrice && <th scope="col">Price</th>}
            <th scope="col">Best for</th>
            <th scope="col">Rating</th>
            <th scope="col"><span class="sr-only">Buy or jump to review</span></th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p) => (
            <tr>
              <th scope="row"><span class="brand-cell">{p.brand}</span><br />{p.name}</th>
              <td data-label="Award"><span class="award">{p.award}</span></td>
              {showGsm && <td data-label="GSM">{p.gsm ?? '—'}</td>}
              {showPrice && <td data-label="Price">{p.price ?? '—'}</td>}
              <td data-label="Best for">{p.bestFor}</td>
              <td data-label="Rating"><Rating value={p.rating} /></td>
              <td class="action">
                <AffiliateButton asin={p.asin} label="Check price" productName={`${p.brand} ${p.name}`} position={`table-${p.rank}`} compact />
                <a href={`#pick-${p.rank}`} class="jump">Details</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

<style>
  .compare { margin-top: 2.5rem; }
  .compare-note { margin-top: .45rem; color: var(--ink-2); font-size: .93rem; }
  .table-scroll td { min-width: 7rem; }
  .table-scroll td:nth-child(4) { min-width: 11rem; }
  .brand-cell { color: var(--ink-3); font-size: .85rem; font-weight: 650; }
  .table-scroll th[scope="row"] { font-weight: 650; min-width: 11rem; }
  .award {
    display: inline-block; background: var(--signal-tint); color: var(--signal-dark);
    font-family: var(--body); font-size: .8rem; font-weight: 650;
    padding: .25rem .7rem; border-radius: 999px; white-space: nowrap;
  }
  .action { white-space: nowrap; }
  .jump { display: block; margin-top: .45rem; font-weight: 600; font-size: .85rem; white-space: nowrap; }

  /* Stacked cards on narrow screens (overrides the .prose table scroll rule). */
  @media (max-width: 40rem) {
    .table-scroll { overflow: visible; border: 0; background: none; }
    .table-scroll table.cmp { display: block; width: 100%; min-width: 0; overflow: visible; background: none; }
    .cmp thead {
      position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
    }
    .cmp tbody { display: block; }
    .cmp tbody tr {
      display: block; margin-bottom: 1rem; padding: .9rem 1rem;
      background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r);
    }
    .cmp tbody th[scope="row"], .cmp tbody td {
      display: block; min-width: 0; width: 100%; padding: .35rem 0; border: 0;
    }
    .cmp tbody th[scope="row"] { font-size: 1.02rem; padding-top: 0; }
    .cmp tbody td[data-label]::before {
      content: attr(data-label); display: block; margin-bottom: .15rem;
      font-family: var(--body); font-size: .8rem; font-weight: 600;
      color: var(--ink-3);
    }
    .cmp td.action { padding-top: .7rem; white-space: normal; }
    .cmp td.action :global(.btn--buy) { width: 100%; }
    .cmp .jump { text-align: center; margin-top: .6rem; }
  }
</style>
