---
export interface Props { pros: string[]; cons: string[]; }
const { pros, cons } = Astro.props;
---
<div class="proscons">
  <div class="pc pc--pro">
    <h4>Pros</h4>
    <ul>{pros.map((p) => <li>{p}</li>)}</ul>
  </div>
  <div class="pc pc--con">
    <h4>Cons</h4>
    <ul>{cons.map((c) => <li>{c}</li>)}</ul>
  </div>
</div>

<style>
  .proscons { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); margin-block: 1.25rem; }
  .pc { border: 1px solid var(--line); border-radius: var(--r); padding: 1rem 1.1rem; }
  .pc h4 { font-size: .78rem; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .6rem; }
  .pc--pro { background: #f2fbf6; border-color: #cbead9; }
  .pc--pro h4 { color: var(--good); }
  .pc--con { background: #fdf4f4; border-color: #f2d5d6; }
  .pc--con h4 { color: var(--bad); }
  .pc ul { list-style: none; padding: 0; margin: 0; font-size: .95rem; }
  .pc li { position: relative; padding-left: 1.4rem; }
  .pc li + li { margin-top: .45rem; }
  .pc--pro li::before { content: "\2713"; position: absolute; left: 0; color: var(--good); font-weight: 700; }
  .pc--con li::before { content: "\2715"; position: absolute; left: 0; color: var(--bad); font-weight: 700; }
</style>
