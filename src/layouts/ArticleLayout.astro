---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import DisclosureBanner from '../components/DisclosureBanner.astro';
import Faq from '../components/Faq.astro';
import { Image } from 'astro:assets';
import diagramMeta from '../data/diagrams.json';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  sectionLabel: string;
  sectionHref: string;
  publishDate: Date;
  updatedDate?: Date;
  author: string;
  image?: ImageMetadata;
  imageAlt?: string;
  readingMinutes?: number;
  schema: Record<string, unknown>[];
  faq?: { q: string; a: string }[];
  related?: string[];
  currentId: string;
  /** Show the affiliate disclosure banner (any page with buy links must). */
  hasAffiliateLinks?: boolean;
}

const {
  title, description, canonical, sectionLabel, sectionHref,
  publishDate, updatedDate, author, image, imageAlt, readingMinutes,
  schema, faq = [], related = [], currentId, hasAffiliateLinks = false,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
/**
 * Only our own diagrams are offered for reuse. Article heroes are sometimes
 * manufacturer product photos, which are not ours to license, so we match the
 * image's original filename against the generated diagram list rather than
 * assuming every hero is ours.
 */
const heroStem = image?.src.split('/').pop()?.split('.')[0] ?? '';
const heroIsOurDiagram = Object.prototype.hasOwnProperty.call(diagramMeta, heroStem);
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image?.src}
  type="article"
  publishedTime={publishDate}
  modifiedTime={updatedDate}
  schema={schema}
>
  <article class="wrap section">
    <div class="prose-wrap">
      <Breadcrumbs items={[{ label: sectionLabel, href: sectionHref }, { label: title, href: canonical }]} />

      <header class="article-head">
        <p class="eyebrow">{sectionLabel}</p>
        <h1>{title}</h1>
        <p class="standfirst">{description}</p>
        <p class="meta byline">
          By {author} &middot;
          {updatedDate ? (
            <> Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>
          ) : (
            <> <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time></>
          )}
          {readingMinutes && <> &middot; {readingMinutes} min read</>}
        </p>
      </header>

      {hasAffiliateLinks && <DisclosureBanner />}

      {image && (
        <Image
          class="hero-img"
          src={image}
          alt={imageAlt ?? ''}
          widths={[480, 800, 1200]}
          sizes="(max-width: 44rem) 100vw, 44rem"
          format="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}

      {image && heroIsOurDiagram && (
        <p class="hero-reuse">
          Diagram by Moshakha — <a href="/diagrams/">free to reuse with a link back</a>.
        </p>
      )}

      <div class="prose">
        <slot />
      </div>

      <Faq items={faq} />

      <RelatedArticles related={related} currentId={currentId} />
    </div>
  </article>
</BaseLayout>

<style>
  .article-head { margin-top: 1rem; }
  .article-head h1 { margin-top: .4rem; }
  .standfirst { font-size: 1.18rem; color: var(--ink-2); margin-top: .9rem; }
  .byline { margin-top: .9rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--rule); }
    .hero-reuse {
    margin: .6rem 0 0;
    font-family: var(--mono);
    font-size: .76rem;
    letter-spacing: .04em;
    color: var(--ink-3);
  }
  .hero-reuse a { color: var(--ink-2); }
  .hero-reuse a:hover { color: var(--signal); }

  /* The lead image is the LCP element — it is eager + high priority, never lazy. */
  .hero-img { border-radius: var(--r); margin-block: 1.75rem; background: var(--paper-2); }
</style>
