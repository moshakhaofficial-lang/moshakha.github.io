---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, analytics } from '../config/site';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const props = Astro.props;

// Organization + WebSite schema belongs on every page.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    description: site.description,
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
];
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <Seo {...props} schema={[...baseSchema, ...(props.schema ?? [])]} />
    <slot name="head" />
    {analytics.ga4MeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4MeasurementId}`}></script>
        <script is:inline define:vars={{ id: analytics.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Sitewide delegated listener for every affiliate link, however it was
      // rendered — AffiliateButton.astro's markup, or links built dynamically
      // (the Car Gear Finder). Any element with data-affiliate qualifies.
      // Lives here rather than per-component so it covers both cases from one
      // place. No-ops silently if GA4 isn't configured (e.g. local dev).
      const w = window as unknown as { gtag?: (...args: unknown[]) => void };
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement)?.closest('a[data-affiliate]') as HTMLAnchorElement | null;
        if (!link || typeof w.gtag !== 'function') return;
        w.gtag('event', 'affiliate_click', {
          page: location.pathname,
          product: link.dataset.product,
          category: link.dataset.category,
          cta_position: link.dataset.position,
          asin: link.dataset.affiliate,
        });
      });
    </script>
  </body>
</html>
