---
/**
 * Diagram library — the 86 diagrams drawn for this site, offered for reuse.
 *
 * The images shown on this page are the Astro-optimised, content-hashed copies
 * from src/assets/images. The URLs we hand out for embedding are the unhashed
 * copies in public/diagrams, written by the same scripts/make-diagrams.mjs run.
 * That split is deliberate: a hashed filename changes whenever the generator
 * runs, which would break every embed anyone else had made.
 *
 * Titles come from src/data/diagrams.json, extracted from the generator so this
 * page cannot drift out of sync with what was actually drawn.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import { site } from '../config/site';
import meta from '../data/diagrams.json';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.webp',
  { eager: true },
);

type Row = { key: string; title: string; sub: string; img: ImageMetadata };

const rows: Row[] = Object.entries(files)
  .map(([path, mod]) => {
    const key = path.split('/').pop()!.replace(/\.webp$/, '');
    const m = (meta as Record<string, { title: string; sub: string }>)[key];
    return { key, title: m?.title ?? key, sub: m?.sub ?? '', img: mod.default };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Car care diagrams, free to reuse',
    url: `${site.url}/diagrams/`,
    description:
      'Original car care and detailing diagrams, free to reuse anywhere with a link back to the source.',
    license: `${site.url}/diagrams/`,
    isAccessibleForFree: true,
    hasPart: rows.slice(0, 30).map((r) => ({
      '@type': 'ImageObject',
      name: r.title,
      contentUrl: `${site.url}/diagrams/${r.key}.webp`,
      creditText: site.name,
      creator: { '@type': 'Organization', name: site.name },
      isAccessibleForFree: true,
    })),
  },
];
---

<BaseLayout
  title="Car Care Diagrams, Free to Reuse"
  description="86 original car care and detailing diagrams, free to use anywhere — on your site, in a forum post, in a presentation — with a link back to the source."
  canonical="/diagrams"
  schema={schema}
>
  <div class="wrap section">
    <Breadcrumbs items={[{ label: 'Diagrams', href: '/diagrams' }]} />

    <header class="dl-head">
      <h1>Car care diagrams, free to reuse</h1>
      <p class="dl-lede">
        We drew {rows.length} diagrams to explain the mechanisms behind car care — why a
        sponge causes swirl marks, what GSM actually measures, how a two-bucket wash
        works. They exist nowhere else, and they are more useful to more people than they
        are sitting on our pages.
      </p>

      <div class="dl-licence">
        <h2 id="terms">You may use these</h2>
        <p>
          Use any diagram on this page anywhere you like — your website, a forum post, a
          presentation, a classroom handout, a video — including commercially. There is no
          fee and you do not need to ask.
        </p>
        <p>
          <strong>One condition:</strong> credit Moshakha with a link back to this page or
          to the article the diagram came from. A visible credit line is enough.
        </p>
        <p class="dl-note">
          Please do not alter a diagram and present the altered version as ours, and please
          do not re-license them or sell them as a stock pack. Each card below gives you a
          permanent image URL and a ready-made credit line — the URLs under
          <code>/diagrams/</code> are stable and safe to hot-link.
        </p>
      </div>
    </header>

    <div class="dl-grid">
      {rows.map((r) => (
        <figure class="dl-card">
          <a href={`/diagrams/${r.key}.webp`} class="dl-imglink">
            <Image
              src={r.img}
              alt={r.title}
              widths={[400, 700]}
              sizes="(max-width: 48rem) 100vw, 22rem"
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption>
            <h3>{r.title}</h3>
            {r.sub && <p class="dl-sub">{r.sub}</p>}
            <div class="dl-actions">
              <button
                class="dl-btn"
                type="button"
                data-copy={`Diagram: ${site.name} — ${site.url}/diagrams/`}
                data-label="Credit line"
              >Copy credit line</button>
              <button
                class="dl-btn dl-btn--ghost"
                type="button"
                data-copy={`<a href="${site.url}/diagrams/"><img src="${site.url}/diagrams/${r.key}.webp" alt="${r.title.replace(/"/g, '&quot;')}" width="1200" height="675" loading="lazy"></a>\n<p>Diagram: <a href="${site.url}/diagrams/">${site.name}</a></p>`}
                data-label="Embed code"
              >Copy embed code</button>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <footer class="dl-foot">
      <h2>Using a lot of them?</h2>
      <p>
        If you are putting several of these in one place — a course, a handbook, a shop
        wall — we would like to know, mostly out of curiosity. Say hello through our
        <a href="/contact/">contact page</a>. You still do not need permission.
      </p>
      <p>
        If you spot something a diagram gets wrong, tell us that too. We would rather fix
        it than have it spread.
      </p>
    </footer>
  </div>

  <script is:inline>
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('button[data-copy]');
      if (!btn) return;
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press Ctrl+C';
        const ta = document.createElement('textarea');
        ta.value = btn.dataset.copy;
        document.body.appendChild(ta);
        ta.select();
        setTimeout(() => ta.remove(), 4000);
      }
      setTimeout(() => { btn.textContent = original; }, 1800);
    });
  </script>

  <style>
    .dl-head { max-width: 46rem; }
    .dl-lede { font-size: 1.1rem; color: var(--ink-2); margin-top: 1rem; }

    .dl-licence {
      margin-top: 1.75rem;
      padding: 1.25rem 1.4rem;
      background: var(--surface);
      border: 2px solid var(--signal);
      border-radius: var(--r);
    }
    .dl-licence h2 { margin: 0 0 .6rem; font-size: 1.15rem; }
    .dl-licence p { margin: .5rem 0 0; }
    .dl-note { font-size: .92rem; color: var(--ink-3); }
    .dl-licence code {
      font-family: var(--mono);
      font-size: .9em;
    }

    .dl-grid {
      margin-top: 2.5rem;
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    }

    .dl-card {
      margin: 0;
      display: flex;
      flex-direction: column;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: var(--r);
      overflow: hidden;
    }
    .dl-imglink { display: block; line-height: 0; }
    .dl-card img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-bottom: 1px solid var(--rule);
    }
    .dl-card figcaption { padding: .9rem 1rem 1rem; display: flex; flex-direction: column; flex: 1; }
    .dl-card h3 { margin: 0; font-size: 1rem; line-height: 1.3; text-wrap: balance; }
    .dl-sub { margin: .35rem 0 0; font-size: .86rem; color: var(--ink-3); }

    .dl-actions { margin-top: auto; padding-top: .85rem; display: flex; flex-wrap: wrap; gap: .4rem; }
    /* Mirrors .btn / .btn--primary from global.css at a smaller card scale. */
    .dl-btn {
      font-family: var(--mono);
      font-size: .74rem;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: .45rem .8rem;
      border-radius: 999px;
      border: 1px solid var(--signal);
      background: var(--signal);
      color: #140a05;
      cursor: pointer;
      transition: background-color .15s ease, color .15s ease;
    }
    .dl-btn--ghost { background: transparent; color: var(--signal); }
    .dl-btn:hover { background: var(--signal-dark); color: #140a05; }
    .dl-btn--ghost:hover { background: var(--signal); }
    .dl-btn:focus-visible { outline: 3px solid var(--signal); outline-offset: 2px; }

    .dl-foot { margin-top: 3rem; max-width: 46rem; }
    .dl-foot h2 { font-size: 1.15rem; }
  </style>
</BaseLayout>
