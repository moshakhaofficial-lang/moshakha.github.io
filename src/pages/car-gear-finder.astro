---
/**
 * Car Gear Finder — an interactive filter over the site's own real product
 * picks, not a separate hand-typed catalogue. Every product shown here is
 * pulled at build time from the same `picks` arrays that power the guide
 * pages, so it can never drift out of sync or list something that doesn't
 * exist elsewhere on the site: add a pick to a guide, tag its goal in
 * GOALS below if needed, and it's automatically available here.
 *
 * No price, rating, review count or availability is invented — everything
 * rendered comes straight from the same content-collection fields the
 * guide pages already display.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { monetization } from '../config/site';
import DisclosureBanner from '../components/DisclosureBanner.astro';

const SIZES = [
  { v: 'any', l: 'Not sure', h: 'Show everything' },
  { v: 'small', l: 'Sedan or hatchback', h: 'Compact and mid-size cars' },
  { v: 'large', l: 'SUV, truck or van', h: 'Bigger paint, bigger gear' },
];
const BUDGETS = [
  { v: 'any', l: 'Any budget', h: 'Show everything' },
  { v: 'budget', l: 'Budget', h: 'Under $20' },
  { v: 'mid', l: 'Mid-range', h: '$20\u2013$60' },
  { v: 'premium', l: 'Premium', h: '$60 and up' },
];

const allGuides = await getCollection('guides');
const bySlug = new Map(allGuides.map((g) => [g.id, g]));

/**
 * Curated goal -> source guide(s) map. This is the entire maintenance
 * surface for adding a new goal: point it at an existing guide's picks (or
 * a how-to guide, for goals with no ranked product guide yet — shown as a
 * "read the guide" fallback rather than faking picks for a category we
 * haven't researched).
 */
const GOALS = [
  { id: 'wash', label: 'Wash it', hint: 'Mitts and soap', guides: ['best-car-wash-mitts', 'best-car-wash-soap'] },
  { id: 'dry', label: 'Dry it', hint: 'Towels, matched to your car', guides: ['best-car-drying-towels'] },
  { id: 'interior', label: 'Clean the interior', hint: 'Vacuum, dash, leather, glass', guides: ['best-car-interior-cleaning-products'] },
  { id: 'paint', label: 'Protect the paint', hint: 'No ranked picks yet — technique guides', guides: [], howTo: ['how-to-use-a-clay-bar', 'how-to-avoid-swirl-marks'] },
  { id: 'wheels', label: 'Clean wheels & tires', hint: 'Dressing and stripping old build-up', guides: ['best-tire-shine'] },
  { id: 'emergency', label: 'Prep for a breakdown', hint: 'Jump starters, inflators', guides: ['best-jump-starters', 'best-tire-inflators'] },
  { id: 'convenience', label: 'Accessorize the car', hint: 'Mounts, organizers, mats', guides: ['best-car-phone-mounts', 'best-trunk-organizers', 'best-car-floor-mats'] },
  { id: 'tech', label: 'Add tech', hint: 'Dash cams', guides: ['best-dash-cams'] },
];

const tag = monetization.amazonTrackingId;
const marketplace = monetization.amazonMarketplace;

const sizeHint = (bestFor: string) => {
  if (/\b(suvs?|trucks?|vans?|large)\b/i.test(bestFor)) return 'large';
  if (/\b(sedans?|hatchbacks?|small|compact)\b/i.test(bestFor)) return 'small';
  return 'any';
};
const budgetTier = (price?: string) => {
  // Prices are ranges like "$30–$45 (2-pack)" — match the FIRST $-prefixed
  // number specifically. Stripping all non-digits first (an earlier version
  // of this did that) concatenates both ends of the range into one bogus
  // number ("$30–$45" -> "3045"), miscategorising nearly everything as
  // premium. Caught by testing the actual filter output, not by inspection.
  const match = price?.match(/\$(\d+(?:\.\d+)?)/);
  const n = match ? parseFloat(match[1]) : NaN;
  if (Number.isNaN(n)) return 'any';
  if (n < 20) return 'budget';
  if (n <= 60) return 'mid';
  return 'premium';
};

// Flatten every goal's picks into one embeddable dataset, in build-time JS.
const results = GOALS.map((goal) => ({
  id: goal.id,
  label: goal.label,
  hint: goal.hint,
  // Populated below — how-to entries live in a separate collection from
  // `guides`, so they're resolved in a second pass once both are loaded.
  fallback: [] as { href: string; title: string; description: string }[],
  picks: goal.guides.flatMap((guideSlug) => {
    const entry = bySlug.get(guideSlug);
    if (!entry) return [];
    return entry.data.picks.map((p) => ({
      source: guideSlug,
      sourceTitle: entry.data.title,
      rank: p.rank,
      name: p.name,
      brand: p.brand,
      award: p.award,
      asin: p.asin,
      rating: p.rating,
      price: p.price ?? null,
      bestFor: p.bestFor,
      size: sizeHint(p.bestFor),
      budget: budgetTier(p.price),
      href: p.asin && tag ? `https://${marketplace}/dp/${p.asin}?tag=${tag}&linkCode=ll1&language=en_US` : null,
    }));
  }),
}));

// how-to fallback links need the how-to collection, resolved separately since
// GOALS mixes two collections and getCollection() is type-specific.
const howToGuides = await getCollection('how-to');
const howToBySlug = new Map(howToGuides.map((g) => [g.id, g]));
for (const goal of GOALS) {
  const r = results.find((x) => x.id === goal.id)!;
  r.fallback = (goal.howTo ?? [])
    .map((slug) => howToBySlug.get(slug))
    .filter(Boolean)
    .map((e) => ({ href: `/how-to/${e!.id}/`, title: e!.data.title, description: e!.data.description }));
}

const dataJson = JSON.stringify(results);
---
<BaseLayout
  title="Car Gear Finder"
  description="Pick your goal, vehicle size and budget — get the real, already-vetted picks from our guides that fit, with nothing invented."
  canonical="/car-gear-finder"
>
  <div class="wrap section finder">
    <p class="eyebrow">The 30-second quiz</p>
    <h1 style="margin-top:.7rem">Car Gear Finder</h1>
    <p class="lede">
      Answer a couple of quick questions. Every product you'll see is a real pick from our own guides &mdash;
      same specs, same pros and cons we'd give you if you read the whole article.
      This just narrows it down faster.
    </p>
    <DisclosureBanner />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <div id="finder" class="quiz">
      <div class="results-bar" id="results-bar">
        <p class="results-summary" id="results-summary"></p>
        <div class="results-actions">
          <button type="button" class="btn btn--ghost" id="btn-edit">Change answers</button>
          <button type="button" class="btn btn--primary" id="btn-copy">Copy link to these results</button>
          <button type="button" class="btn btn--ghost" id="btn-restart">Start over</button>
        </div>
        <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
      </div>

      <form id="finder-form" class="finder-form" method="get" action="/car-gear-finder/">
        <div class="quiz-top" id="quiz-top">
          <p class="quiz-step-label" id="quiz-step-label">Step 1 of 3</p>
          <div class="quiz-bar" aria-hidden="true"><i id="quiz-bar-fill"></i></div>
        </div>

        <fieldset class="step" data-step="goal" tabindex="-1">
          <legend>What are you trying to do?</legend>
          <div class="opt-grid">
            {GOALS.map((g) => (
              <label class="opt">
                <input type="radio" name="goal" value={g.id} />
                <span class="opt-label">{g.label}</span>
                <span class="opt-hint">{g.hint}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="step" data-step="size" tabindex="-1">
          <legend>What size is your vehicle?</legend>
          <div class="opt-grid">
            {SIZES.map((o) => (
              <label class="opt">
                <input type="radio" name="size" value={o.v} checked={o.v === 'any'} />
                <span class="opt-label">{o.l}</span>
                <span class="opt-hint">{o.h}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="step" data-step="budget" tabindex="-1">
          <legend>What's your budget?</legend>
          <div class="opt-grid">
            {BUDGETS.map((o) => (
              <label class="opt">
                <input type="radio" name="budget" value={o.v} checked={o.v === 'any'} />
                <span class="opt-label">{o.l}</span>
                <span class="opt-hint">{o.h}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="step" data-step="sort">
          <legend>Sort by</legend>
          <div class="seg">
            <label class="seg-opt"><input type="radio" name="sort" value="editorial" checked /><span>Our top pick first</span></label>
            <label class="seg-opt"><input type="radio" name="sort" value="cheapest" /><span>Cheapest first</span></label>
          </div>
        </fieldset>

        <button type="submit" class="btn btn--primary finder-submit">Show my picks</button>

        <div class="quiz-nav" id="quiz-nav">
          <button type="button" class="btn btn--ghost" id="btn-back">Back</button>
          <button type="button" class="btn btn--primary" id="btn-next">Next</button>
        </div>
      </form>

      <noscript>
        <div class="nojs">
          <p>The quiz needs JavaScript to filter picks. Without it, jump straight to the guide for what you're doing:</p>
          <ul>
            {GOALS.map((g) => (
              <li>
                <strong>{g.label}</strong>:
                {[...g.guides.map((s) => ({ href: `/guides/${s}/`, t: bySlug.get(s)?.data.title })), ...(g.howTo ?? []).map((s) => ({ href: `/how-to/${s}/`, t: howToBySlug.get(s)?.data.title }))]
                  .filter((x) => x.t)
                  .map((x, i) => <> {i > 0 && '·'} <a href={x.href}>{x.t}</a></>)}
              </li>
            ))}
          </ul>
        </div>
      </noscript>

      <div id="finder-results" class="finder-results" aria-live="polite"></div>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="finder-data" set:html={dataJson} />

<script>
  type Pick = {
    source: string; sourceTitle: string; rank: number; name: string; brand: string;
    award: string; asin: string | null; rating: number; price: string | null;
    bestFor: string; size: string; budget: string; href: string | null;
  };
  type Goal = {
    id: string; label: string; hint: string; picks: Pick[];
    fallback: { href: string; title: string; description: string }[];
  };
  type Step = 'goal' | 'size' | 'budget';

  const dataEl = document.getElementById('finder-data');
  const goals: Goal[] = JSON.parse(dataEl?.textContent ?? '[]');
  const root = document.getElementById('finder') as HTMLElement;
  const form = document.getElementById('finder-form') as HTMLFormElement;
  const resultsEl = document.getElementById('finder-results') as HTMLElement;
  const stepLabel = document.getElementById('quiz-step-label') as HTMLElement;
  const barFill = document.getElementById('quiz-bar-fill') as HTMLElement;
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const btnCopy = document.getElementById('btn-copy') as HTMLButtonElement;
  const btnEdit = document.getElementById('btn-edit') as HTMLButtonElement;
  const btnRestart = document.getElementById('btn-restart') as HTMLButtonElement;
  const copyStatus = document.getElementById('copy-status') as HTMLElement;
  const summaryEl = document.getElementById('results-summary') as HTMLElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function starString(rating: number): string {
    return '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating));
  }

  const radios = (name: string) => Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`));
  const val = (name: string) => radios(name).find((r) => r.checked)?.value ?? '';
  const setVal = (name: string, v: string) => {
    const r = radios(name).find((x) => x.value === v);
    if (r) r.checked = true;
    return !!r;
  };
  const optText = (name: string) =>
    radios(name).find((r) => r.checked)?.closest('label')?.querySelector('.opt-label')?.textContent ?? '';

  /**
   * Which questions matter for a goal, derived from the same filtering rules
   * render() applies: a goal with only how-to fallbacks ignores size and
   * budget; size/budget are asked only when at least one pick is tagged.
   */
  function stepsFor(goalId: string): Step[] {
    const steps: Step[] = ['goal'];
    const g = goals.find((x) => x.id === goalId);
    if (!g || g.fallback.length > 0 || g.picks.length === 0) return steps;
    if (g.picks.some((p) => p.size !== 'any')) steps.push('size');
    if (g.picks.some((p) => p.budget !== 'any')) steps.push('budget');
    return steps;
  }

  function render() {
    const goalId = val('goal');
    const size = val('size');
    const budget = val('budget');
    const sort = val('sort');

    const goal = goals.find((g) => g.id === goalId);
    resultsEl.textContent = '';
    if (!goal) return;

    let picks = goal.picks.filter(
      (p) => (size === 'any' || p.size === 'any' || p.size === size) &&
             (budget === 'any' || p.budget === 'any' || p.budget === budget),
    );
    // Same fix as budgetTier() at build time: match the first $-prefixed
    // number specifically rather than stripping all non-digits, which
    // concatenates both ends of a "$30–$45" range into one bogus figure.
    const firstPrice = (price: string | null) => {
      const match = price?.match(/\$(\d+(?:\.\d+)?)/);
      return match ? parseFloat(match[1]) : 999;
    };
    picks = picks.sort((a, b) => (sort === 'cheapest'
      ? firstPrice(a.price) - firstPrice(b.price)
      : a.rank - b.rank));

    const heading = document.createElement('h2');
    heading.className = 'finder-heading';
    heading.id = 'finder-heading';
    heading.tabIndex = -1;
    heading.textContent = goal.label;
    resultsEl.appendChild(heading);

    if (picks.length === 0 && goal.fallback.length === 0) {
      const p = document.createElement('p');
      p.className = 'finder-empty';
      p.textContent = 'No picks match that combination — try widening the budget or vehicle size.';
      resultsEl.appendChild(p);
      return;
    }

    if (goal.fallback.length > 0) {
      const note = document.createElement('p');
      note.className = 'finder-note';
      note.textContent = "We don't have ranked product picks for this goal yet — these guides cover the technique:";
      resultsEl.appendChild(note);
      const list = document.createElement('div');
      list.className = 'grid grid--2';
      for (const f of goal.fallback) {
        const card = document.createElement('a');
        card.className = 'card card--link';
        card.href = f.href;
        const h3 = document.createElement('h3');
        h3.textContent = f.title;
        const p = document.createElement('p');
        p.textContent = f.description;
        card.append(h3, p);
        list.appendChild(card);
      }
      resultsEl.appendChild(list);
      return;
    }

    if (picks.length === 0) {
      const p = document.createElement('p');
      p.className = 'finder-empty';
      p.textContent = 'No picks match that combination — try widening the budget or vehicle size.';
      resultsEl.appendChild(p);
      return;
    }

    const grid = document.createElement('div');
    grid.className = 'finder-grid';
    for (const pick of picks.slice(0, 6)) {
      const card = document.createElement('article');
      card.className = 'finder-card';

      const award = document.createElement('p');
      award.className = 'finder-award';
      award.textContent = pick.award;

      const name = document.createElement('h3');
      name.textContent = `${pick.brand} ${pick.name}`;

      const meta = document.createElement('p');
      meta.className = 'finder-meta';
      const stars = document.createElement('span');
      stars.className = 'finder-stars';
      stars.textContent = `${starString(pick.rating)} ${pick.rating.toFixed(1)}`;
      meta.appendChild(stars);
      if (pick.price) {
        const chip = document.createElement('span');
        chip.className = 'chip';
        chip.textContent = pick.price;
        meta.appendChild(chip);
      }

      const bestFor = document.createElement('p');
      bestFor.className = 'finder-bestfor';
      bestFor.textContent = pick.bestFor;

      const source = document.createElement('a');
      source.className = 'finder-source';
      source.href = `/guides/${pick.source}/#pick-${pick.rank}`;
      source.textContent = `Full comparison in ${pick.sourceTitle}`;

      card.append(award, name, meta, bestFor, source);

      if (pick.href) {
        const btn = document.createElement('a');
        btn.className = 'btn btn--buy';
        btn.href = pick.href;
        btn.target = '_blank';
        btn.rel = 'nofollow sponsored noopener';
        btn.dataset.affiliate = pick.asin ?? '';
        btn.dataset.product = `${pick.brand} ${pick.name}`;
        btn.dataset.category = 'car-gear-finder';
        btn.dataset.position = `finder-${goal.id}`;
        btn.textContent = 'Check price on Amazon';
        card.appendChild(btn);
      } else {
        const span = document.createElement('span');
        span.className = 'btn btn--buy';
        span.setAttribute('aria-disabled', 'true');
        span.textContent = 'Link pending';
        card.appendChild(span);
      }

      grid.appendChild(card);
    }
    resultsEl.appendChild(grid);
  }

  /* ---------- quiz state, URL and navigation ---------- */
  const base = location.pathname;
  let view: Step | 'results' = 'goal';

  function buildQuery(): URLSearchParams {
    const g = val('goal');
    const steps = stepsFor(g);
    const q = new URLSearchParams();
    q.set('goal', g);
    if (steps.includes('size')) q.set('size', val('size'));
    if (steps.includes('budget')) q.set('budget', val('budget'));
    if (val('sort') === 'cheapest') q.set('sort', 'cheapest');
    return q;
  }

  /** Restores answers from the query string. True when it names a real goal. */
  function applyParams(): boolean {
    const q = new URLSearchParams(location.search);
    const g = q.get('goal');
    if (!g || !goals.some((x) => x.id === g)) return false;
    setVal('goal', g);
    setVal('size', q.get('size') ?? 'any') || setVal('size', 'any');
    setVal('budget', q.get('budget') ?? 'any') || setVal('budget', 'any');
    setVal('sort', q.get('sort') === 'cheapest' ? 'cheapest' : 'editorial');
    return true;
  }

  function updateNav() {
    const steps = stepsFor(val('goal'));
    if (view === 'results') return;
    const idx = steps.indexOf(view);
    const total = Math.max(steps.length, 1);
    stepLabel.textContent = `Step ${idx + 1} of ${total}`;
    barFill.style.width = `${((idx + 1) / total) * 100}%`;
    btnBack.hidden = idx <= 0;
    const last = idx >= steps.length - 1;
    btnNext.textContent = last ? 'See my picks' : 'Next';
    btnNext.disabled = view === 'goal' && !val('goal');
  }

  function focusSoon(el: HTMLElement | null) {
    if (el) requestAnimationFrame(() => el.focus({ preventScroll: false }));
  }

  function showStep(step: Step, focus = true) {
    view = step;
    root.dataset.view = step;
    updateNav();
    if (focus) focusSoon(form.querySelector<HTMLElement>(`.step[data-step="${step}"]`));
  }

  function showResults(opts: { push: boolean; focus?: boolean }) {
    view = 'results';
    root.dataset.view = 'results';
    render();
    const parts = [optText('goal')];
    const steps = stepsFor(val('goal'));
    if (steps.includes('size') && val('size') !== 'any') parts.push(optText('size'));
    if (steps.includes('budget') && val('budget') !== 'any') parts.push(optText('budget'));
    summaryEl.textContent = parts.filter(Boolean).join(' · ');
    copyStatus.textContent = '';
    const url = `${base}?${buildQuery().toString()}`;
    if (opts.push) history.pushState(null, '', url);
    else history.replaceState(null, '', url);
    if (opts.focus !== false) focusSoon(document.getElementById('finder-heading'));
  }

  function next() {
    const steps = stepsFor(val('goal'));
    if (view === 'results') return;
    if (view === 'goal' && !val('goal')) return;
    const idx = steps.indexOf(view);
    if (idx < steps.length - 1) showStep(steps[idx + 1]);
    else showResults({ push: true });
  }

  function back() {
    const steps = stepsFor(val('goal'));
    if (view === 'results') {
      history.replaceState(null, '', base);
      showStep(steps[steps.length - 1]);
      return;
    }
    const idx = steps.indexOf(view);
    if (idx > 0) showStep(steps[idx - 1]);
  }

  function restart() {
    radios('goal').forEach((r) => (r.checked = false));
    setVal('size', 'any');
    setVal('budget', 'any');
    setVal('sort', 'editorial');
    history.replaceState(null, '', base);
    showStep('goal');
  }

  btnNext.addEventListener('click', next);
  btnBack.addEventListener('click', back);
  btnEdit.addEventListener('click', back);
  btnRestart.addEventListener('click', restart);

  // Enter on a focused option submits the form: treat it as "Next".
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    next();
  });

  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'sort' && view === 'results') showResults({ push: false, focus: false });
    else updateNav();
  });

  // Pointer taps on an option card advance automatically; keyboard users
  // (arrow keys / space) pick an option and press Next, so arrowing through
  // the list never skips ahead. Real clicks have detail > 0.
  form.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const label = t.closest('label.opt');
    if (!label || t.tagName === 'INPUT' || (e as MouseEvent).detail === 0) return;
    if (view === 'results') return;
    window.setTimeout(next, reduceMotion ? 0 : 160);
  });

  btnCopy.addEventListener('click', async () => {
    const url = location.href;
    let ok = false;
    try {
      await navigator.clipboard.writeText(url);
      ok = true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = url;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
      document.body.appendChild(ta);
      ta.select();
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      ta.remove();
    }
    copyStatus.textContent = ok ? 'Copied ✓' : 'Could not copy — copy the address from your browser bar.';
    copyStatus.classList.toggle('is-ok', ok);
    window.setTimeout(() => { copyStatus.textContent = ''; }, 3500);
  });

  window.addEventListener('popstate', () => {
    if (applyParams()) showResults({ push: false, focus: false });
    else showStep(stepsFor(val('goal')).includes(view as Step) ? (view as Step) : 'goal', false);
  });

  // Initial state: a shared link goes straight to its results; otherwise the quiz
  // starts with no goal chosen (the no-JS form has none checked either).
  if (applyParams()) showResults({ push: false, focus: false });
  else {
    radios('goal').forEach((r) => (r.checked = false));
    showStep('goal', false);
  }
</script>

<style is:global>
  .finder .lede { color: var(--ink-2); font-size: 1.1rem; max-width: 56ch; margin-top: .6rem; }
  .finder .finder-form { margin-top: 1.5rem; }
  .finder fieldset { border: none; padding: 0; margin: 0; min-width: 0; }
  .finder fieldset:focus { outline: none; }
  .finder legend {
    font-family: var(--display); font-weight: 800; letter-spacing: -.03em; line-height: 1.1;
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.25rem); color: var(--ink); padding: 0 0 1.1rem;
  }
  .finder .step[data-step="sort"] legend { font-size: .95rem; font-weight: 700; letter-spacing: 0; padding-bottom: .5rem; color: var(--ink-2); }

  /* ----- step visibility: all shown with no JS; one at a time with it ----- */
  .js .finder .step { display: none; }
  .js #finder:not([data-view]) .step[data-step="goal"],
  .js #finder[data-view="goal"] .step[data-step="goal"],
  .js #finder[data-view="size"] .step[data-step="size"],
