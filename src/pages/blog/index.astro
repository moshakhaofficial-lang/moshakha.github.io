---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config/site';

const entries = (await getCollection('blog'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate);

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
  ],
}];
---
<BaseLayout title="Blog" description="Short, practical answers to the car cleaning questions people actually ask." canonical="/blog" schema={schema}>
  <div class="wrap section">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }]} />
    <h1 style="margin-top:1rem">Blog</h1>
    <p class="lede">Short, practical answers to the car cleaning questions people actually ask.</p>

    {entries.length > 0 ? (
      <div class="grid grid--3" style="margin-top:2rem">
        {entries.map((entry) => (
          <article class="card card--link">
            <p class="meta">
              <time datetime={entry.data.publishDate.toISOString()}>
                {entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </p>
            <h3><a href={`/blog/${entry.id}`}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty">No articles published yet — this section fills up in the first content batch.</p>
    )}
  </div>
</BaseLayout>

<style>
  .lede { color: var(--ink-2); font-size: 1.15rem; max-width: 58ch; margin-top: .6rem; }
  .empty { margin-top: 2rem; padding: 2.5rem; border: 1px dashed var(--rule); border-radius: var(--r); color: var(--ink-3); text-align: center; }
</style>
