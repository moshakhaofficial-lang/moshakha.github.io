---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';

const published = (c) => c.filter((e) => !e.data.draft);
const guides = published(await getCollection('guides'));
const howTo = published(await getCollection('how-to'));
const reviews = published(await getCollection('reviews'));
const blog = published(await getCollection('blog'));

const featured = [...guides, ...howTo]
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate)
  .slice(0, 3);

const sectionLabel = { guides: 'Buying Guide', 'how-to': 'How-To', reviews: 'Review', blog: 'Blog' };

/**
 * The hero panel states the site's central claim as data. Every buying guide
 * here attacks a headline spec that buyers are sold on but which does not
 * predict performance — this table is that argument in one view.
 */
const specRows = [
  { cat: 'Microfibre', sold: 'GSM', real: 'Weave + blend', href: '/guides/microfiber-gsm-explained' },
  { cat: 'Jump starters', sold: 'Peak amps', real: 'Protection circuitry', href: '/guides/best-jump-starters' },
  { cat: 'Dash cams', sold: '4K', real: 'Sensor + capacitor', href: '/guides/best-dash-cams' },
  { cat: 'Pressure washers', sold: 'PSI', real: 'Flow rate', href: '/guides/best-pressure-washers-for-cars' },
  { cat: 'Tyre pressure', sold: 'Sidewall max', real: 'Door placard', href: '/how-to/how-to-check-tire-pressure' },
];
---
<BaseLayout
  title="Moshakha — Car Gear, Decoded"
  description={site.description}
  canonical="/"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Independent &middot; Reader-supported</p>
        <h1>The headline spec is usually the wrong one.</h1>
        <p class="lede">
          Car gear is sold on a single big number &mdash; GSM, peak amps, 4K, PSI.
          We decode what those numbers actually predict, then tell you what's worth buying.
        </p>
        <div class="hero-cta">
          <a href="/guides" class="btn btn--primary">Browse buying guides</a>
          <a href="/how-to" class="btn btn--ghost">Learn the techniques</a>
        </div>
      </div>

      <aside class="spec" aria-label="Headline specs versus the specs that matter">
        <div class="spec-head">
          <span>Sold on</span><span>What matters</span>
        </div>
        {specRows.map((row) => (
          <a class="spec-row" href={row.href}>
            <span class="spec-cat">{row.cat}</span>
            <b class="spec-sold">{row.sold}</b>
            <span class="spec-real">{row.real}</span>
          </a>
        ))}
        <p class="spec-foot">Five categories, same pattern &mdash; the loud number is rarely the useful one</p>
      </aside>
    </div>
  </section>

  <section class="trust">
    <div class="wrap">
      <ul>
        <li><b>No sponsored placements</b>Brands cannot pay for a spot in our rankings.</li>
        <li><b>Specs decoded</b>We say when the headline number is marketing.</li>
        <li><b>Dated and revised</b>Every guide carries a visible last-updated date.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Start here</p>
      <h2 style="margin-top:.7rem">The guides most people land on first</h2>
      {featured.length > 0 && (
        <div class="grid grid--3" style="margin-top:1.5rem">
          {featured.map((entry) => (
            <article class="card card--link">
              <p class="label">{sectionLabel[entry.collection]}</p>
              <h3><a href={`/${entry.collection}/${entry.id}`}>{entry.data.title}</a></h3>
              <p>{entry.data.description}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Sections</p>
      <h2 style="margin-top:.7rem">What we cover</h2>
      <div class="grid grid--2" style="margin-top:1.5rem">
        <article class="card card--link">
          <p class="label">{guides.length} articles</p>
          <h3><a href="/guides">Buying guides</a></h3>
          <p>Ranked roundups with comparison tables, so you can decide in two minutes.</p>
        </article>
        <article class="card card--link">
          <p class="label">{howTo.length} articles</p>
          <h3><a href="/how-to">How-to guides</a></h3>
          <p>Technique &mdash; washing, drying, interiors, glass &mdash; without swirl marks.</p>
        </article>
        <article class="card card--link">
          <p class="label">{reviews.length} articles</p>
          <h3><a href="/reviews">Product reviews</a></h3>
          <p>Single-product deep dives: what it's good at, where it falls down, who it suits.</p>
        </article>
        <article class="card card--link">
          <p class="label">{blog.length} articles</p>
          <h3><a href="/blog">Blog</a></h3>
          <p>Shorter answers to the specific questions detailers actually search for.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 4.25rem); }
  .hero-grid {
    display: grid; gap: clamp(1.75rem, 4vw, 3rem);
    grid-template-columns: 1.15fr .85fr; align-items: start;
  }
  .hero h1 { margin-top: .75rem; }
  .lede {
    margin-top: .95rem; font-size: clamp(1.02rem, .98rem + .35vw, 1.16rem);
    color: var(--ink-2); max-width: 42ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.6rem; }

  /* The spec panel is the hero's second column — it fills the space that
     was empty before, and states the thesis as data rather than a claim. */
  .spec { border: 1px solid var(--rule-hard); border-radius: var(--r); background: var(--surface); }
  .spec-head {
    display: flex; justify-content: space-between; gap: 1rem;
    background: var(--rule-hard); color: var(--paper);
    font-family: var(--mono); font-weight: 500; font-size: .64rem;
    letter-spacing: .11em; text-transform: uppercase; padding: .5rem .75rem;
  }
  .spec-row {
    display: grid; grid-template-columns: 1fr auto auto; align-items: baseline;
    gap: .5rem .7rem; padding: .55rem .75rem; border-bottom: 1px solid var(--rule-2);
    text-decoration: none; color: inherit;
  }
  .spec-row:last-of-type { border-bottom: 0; }
  .spec-row:hover { background: var(--paper-2); }
  .spec-cat { font-size: .84rem; color: var(--ink-2); }
  .spec-sold {
    font-family: var(--mono); font-weight: 500; font-size: .76rem;
    color: var(--ink-3); text-decoration: line-through;
  }
  .spec-real {
    font-family: var(--mono); font-size: .76rem; font-weight: 500;
    color: var(--signal-dark); text-align: right; white-space: nowrap;
  }
  .spec-foot {
    padding: .6rem .75rem; font-family: var(--mono); font-size: .66rem;
    letter-spacing: .04em; color: var(--ink-3); background: var(--paper-2);
  }

  .trust { border-block: 1px solid var(--rule); background: var(--paper-2); padding-block: 1.4rem; }
  .trust ul {
    list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    font-size: .89rem; color: var(--ink-2);
  }
  .trust b {
    display: block; color: var(--ink); font-family: var(--mono); font-weight: 500;
    font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .25rem;
  }

  @media (max-width: 46rem) {
    .hero-grid { grid-template-columns: 1fr; }
  }
</style>
