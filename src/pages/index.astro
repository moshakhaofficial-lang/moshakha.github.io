---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';

const COLLECTIONS = ['guides', 'how-to', 'reviews', 'blog'] as const;
const LABEL = { guides: 'Buying Guide', 'how-to': 'How-To', reviews: 'Review', blog: 'Blog' };

const all = (
  await Promise.all(
    COLLECTIONS.map(async (c) => {
      const entries = await getCollection(c).catch(() => []);
      return entries
        .filter((e) => !e.data.draft)
        .map((e) => ({ ...e, ref: `${c}/${e.id}`, href: `/${c}/${e.id}/` }));
    }),
  )
).flat();

const byRef = new Map(all.map((e) => [e.ref, e]));

/**
 * Curated rather than sorted by date. These are the three best entry points to
 * the site, not simply the three most recent things written.
 */
const FEATURED = [
  'guides/microfiber-gsm-explained',
  'guides/best-car-drying-towels',
  'guides/best-dash-cams',
];
const featured = FEATURED.map((r) => byRef.get(r)).filter(Boolean);

const latest = [...all]
  .sort((a, b) => +(b.data.updatedDate ?? b.data.publishDate) - +(a.data.updatedDate ?? a.data.publishDate))
  .slice(0, 8);

const counts = Object.fromEntries(
  COLLECTIONS.map((c) => [c, all.filter((e) => e.collection === c).length]),
);

/**
 * The hero panel states the site's central claim as data. Every buying guide
 * here attacks a headline spec that buyers are sold on but which does not
 * predict performance — this table is that argument in one view.
 */
const specRows = [
  { cat: 'Microfibre', sold: 'GSM', real: 'Weave + blend', href: '/guides/microfiber-gsm-explained/' },
  { cat: 'Jump starters', sold: 'Peak amps', real: 'Protection circuitry', href: '/guides/best-jump-starters/' },
  { cat: 'Dash cams', sold: '4K', real: 'Sensor + capacitor', href: '/guides/best-dash-cams/' },
  { cat: 'Pressure washers', sold: 'PSI', real: 'Flow rate', href: '/guides/best-pressure-washers-for-cars/' },
  { cat: 'Tyre pressure', sold: 'Sidewall max', real: 'Door placard', href: '/how-to/how-to-check-tire-pressure/' },
];

/** Routes people by the job they are doing rather than by our taxonomy. */
const jobs = [
  {
    q: 'Wash it without adding swirl marks',
    hint: 'The wash does more paint damage than anything else',
    links: [
      'how-to/two-bucket-car-wash-method',
      'how-to/wash-mitt-vs-sponge',
      'guides/best-car-wash-mitts',
      'guides/best-car-wash-soap',
      'reviews/rag-company-cyclone-wash-mitt',
    ],
  },
  {
    q: 'Dry it without water spots or streaks',
    hint: 'Second-highest risk step, and the one people improvise',
    links: [
      'guides/best-car-drying-towels',
      'guides/microfiber-gsm-explained',
      'guides/best-microfiber-towels-for-cars',
      'how-to/why-microfiber-towels-leave-streaks',
      'blog/microfibre-care-101',
      'reviews/rag-company-gauntlet-drying-towel',
      'reviews/chemical-guys-woolly-mammoth-drying-towel',
    ],
  },
  {
    q: 'Clean the interior properly',
    hint: 'Where the wrong chemistry does permanent damage',
    links: [
      'blog/perfect-interior-detail',
      'guides/best-car-interior-cleaning-products',
      'how-to/how-to-clean-car-floor-mats',
      'reviews/thisworx-car-vacuum',
    ],
  },
  {
    q: 'Fix paint that is already swirled',
    hint: 'Correction is finite — the method has to change first',
    links: [
      'how-to/how-to-avoid-swirl-marks',
      'how-to/how-to-use-a-clay-bar',
      'blog/ceramic-coating-guide',
    ],
  },
  {
    q: 'Sort out the wheels and tyres',
    hint: 'Always first, always with separate tools',
    links: [
      'blog/wheel-rim-care',
      'guides/best-tire-shine',
      'how-to/how-to-check-tire-pressure',
      'guides/best-car-floor-mats',
    ],
  },
  {
    q: 'Kit the car out, or cover a breakdown',
    hint: 'Where the headline spec misleads hardest',
    links: [
      'guides/best-jump-starters',
      'guides/best-tire-inflators',
      'guides/best-dash-cams',
      'guides/best-car-phone-mounts',
      'guides/best-trunk-organizers',
      'how-to/how-to-jump-start-a-car',
    ],
  },
].map((j) => ({ ...j, items: j.links.map((r) => byRef.get(r)).filter(Boolean) }));

const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---
<BaseLayout title="Moshakha — Car Gear, Decoded" description={site.description} canonical="/">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Independent &middot; Reader-supported</p>
        <h1>The headline spec is usually the wrong one.</h1>
        <p class="lede">
          Car gear is sold on a single big number &mdash; GSM, peak amps, 4K, PSI.
          We decode what those numbers actually predict, then tell you what's worth buying.
        </p>
        <div class="hero-cta">
          <a href="/guides/" class="btn btn--primary">Browse buying guides</a>
          <a href="#find" class="btn btn--ghost">Find your answer</a>
        </div>
      </div>

      <aside class="spec" aria-label="Headline specs versus the specs that matter">
        <div class="spec-head"><span>Sold on</span><span>What matters</span></div>
        {specRows.map((row) => (
          <a class="spec-row" href={row.href}>
            <span class="spec-cat">{row.cat}</span>
            <b class="spec-sold">{row.sold}</b>
            <span class="spec-real">{row.real}</span>
          </a>
        ))}
        <p class="spec-foot">Five categories, same pattern &mdash; the loud number is rarely the useful one</p>
      </aside>
    </div>
  </section>

  <section class="trust">
    <div class="wrap">
      <ul>
        <li><b>No sponsored placements</b>Brands cannot pay for a spot in our rankings.</li>
        <li><b>Specs decoded</b>We say when the headline number is marketing.</li>
        <li><b>Dated and revised</b>Every guide carries a visible last-updated date.</li>
      </ul>
    </div>
  </section>

  <!-- Routes by the job someone is doing, not by our own taxonomy. -->
  <section class="section" id="find">
    <div class="wrap">
      <p class="eyebrow">Start here</p>
      <h2 style="margin-top:1rem">What are you trying to do?</h2>
      <p class="sec-lede">
        Pick the job. We'll point you at the guides that cover it &mdash; in the order
        we'd actually do them. Already know your budget and vehicle size?
        <a href="/car-gear-finder/">Try the Gear Finder</a> instead.
      </p>

      <div class="router">
        {jobs.map((job, i) => (
          <details class="job" open={i === 0}>
            <summary>
              <span class="job-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="job-text">
                <span class="job-q">{job.q}</span>
                <span class="job-hint">{job.hint}</span>
              </span>
            </summary>
            <ul class="job-links">
              {job.items.map((e) => (
                <li>
                  <a href={e.href}>
                    <span class="job-label">{LABEL[e.collection]}</span>
                    <span class="job-title">{e.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">If you only read three</p>
      <h2 style="margin-top:1rem">Where to start</h2>
      <div class="grid grid--3" style="margin-top:1.5rem">
        {featured.map((entry) => (
          <article class="card card--link">
            <p class="label">{LABEL[entry.collection]}</p>
            <h3><a href={entry.href}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="latest-head">
        <div>
          <p class="eyebrow">Recently published</p>
          <h2 style="margin-top:1rem">Latest</h2>
        </div>
        <p class="latest-count tabular">
          {`${all.length} articles · ${counts.guides} guides · ${counts['how-to']} how-tos · ${counts.reviews} reviews · ${counts.blog} posts`}
        </p>
      </div>

      <ol class="latest">
        {latest.map((e) => (
          <li>
            <a href={e.href}>
              <span class="latest-label">{LABEL[e.collection]}</span>
              <span class="latest-title">{e.data.title}</span>
              <time class="latest-date tabular" datetime={(e.data.updatedDate ?? e.data.publishDate).toISOString()}>
                {fmt(e.data.updatedDate ?? e.data.publishDate)}
              </time>
            </a>
          </li>
        ))}
      </ol>

      <p class="latest-more">
        <a href="/guides/">Buying guides</a> &middot;
        <a href="/how-to/">How-to guides</a> &middot;
        <a href="/reviews/">Reviews</a> &middot;
        <a href="/blog/">Blog</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem); position: relative; }
  .hero-grid {
    display: grid; gap: clamp(2rem, 5vw, 3.5rem);
    grid-template-columns: 1.1fr .9fr; align-items: center;
  }
  .hero h1 { margin-top: 1.1rem; }
  .hero h1::after {
    content: ""; display: block; width: 4.5rem; height: 5px; border-radius: 99px;
    margin-top: 1.3rem; background: linear-gradient(90deg, var(--signal), transparent);
  }
  .lede {
    margin-top: 1.3rem; font-size: clamp(1.05rem, 1rem + .4vw, 1.22rem);
    color: var(--ink-2); max-width: 44ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .sec-lede { color: var(--ink-2); margin-top: .7rem; max-width: 54ch; }

  /* ---- hero spec panel (glass) ---- */
  .spec {
    border: 1px solid var(--rule-hard); border-radius: 20px; overflow: hidden;
    background: linear-gradient(180deg, rgba(27,31,40,.85), rgba(17,19,25,.85));
    box-shadow: 0 30px 80px -30px rgba(255,106,43,.35), inset 0 1px 0 rgba(255,255,255,.05);
  }
  .spec-head {
    display: flex; justify-content: space-between; gap: 1rem;
    color: var(--ink-3); border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-weight: 500; font-size: .64rem;
    letter-spacing: .12em; text-transform: uppercase; padding: .8rem 1.05rem;
  }
  .spec-row {
    display: grid; grid-template-columns: 1fr auto auto; align-items: baseline;
    gap: .5rem .8rem; padding: .8rem 1.05rem; border-bottom: 1px solid var(--rule-2);
    text-decoration: none; color: inherit; transition: background-color .15s ease;
  }
  .spec-row:last-of-type { border-bottom: 0; }
  .spec-row:hover { background: var(--signal-tint); }
  .spec-cat { font-size: .88rem; color: var(--ink); font-weight: 600; }
  .spec-sold {
    font-family: var(--mono); font-weight: 500; font-size: .76rem;
    color: var(--ink-3); text-decoration: line-through; text-decoration-color: var(--bad);
  }
  .spec-real {
    font-family: var(--mono); font-size: .76rem; font-weight: 500;
    color: var(--signal); text-align: right; white-space: nowrap;
  }
  .spec-foot {
    padding: .8rem 1.05rem; font-family: var(--mono); font-size: .66rem;
    letter-spacing: .04em; color: var(--ink-3); background: rgba(0,0,0,.25);
  }

  /* ---- trust bar ---- */
  .trust { border-block: 1px solid var(--rule); background: var(--paper-2); padding-block: 1.8rem; }
  .trust ul {
    list-style: none; padding: 0; margin: 0; display: grid; gap: 1.4rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    font-size: .9rem; color: var(--ink-2);
  }
  .trust b {
    display: block; color: var(--ink); font-family: var(--mono); font-weight: 500;
    font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .35rem;
  }
  .trust li::before { content: ""; display: block; width: 1.6rem; height: 3px; border-radius: 9px; background: var(--signal); margin-bottom: .7rem; }

  /* ---- job router ---- */
  .router { margin-top: 2rem; display: grid; gap: .7rem; }
  .job {
    border: 1px solid var(--rule); border-radius: var(--r);
    background: linear-gradient(180deg, var(--surface), var(--paper-2));
    transition: border-color .2s ease;
  }
  .job:hover, .job[open] { border-color: rgba(255,106,43,.45); }
  .job summary {
    display: flex; align-items: flex-start; gap: 1rem;
    padding: 1.1rem 1.3rem; cursor: pointer; list-style: none;
  }
  .job summary::-webkit-details-marker { display: none; }
  .job-n {
    font-family: var(--mono); font-size: .72rem; font-weight: 500;
    color: var(--signal); padding-top: .28rem; flex: none;
  }
  .job-text { display: flex; flex-direction: column; gap: .15rem; flex: 1; }
  .job-q { font-weight: 700; font-size: 1.06rem; letter-spacing: -.015em; }
  .job-hint { font-size: .86rem; color: var(--ink-3); }
  .job summary::after {
    content: "+"; font-family: var(--mono); font-size: 1rem; line-height: 1;
    color: var(--ink-2); flex: none; width: 1.8rem; height: 1.8rem;
    display: grid; place-items: center; border: 1px solid var(--rule-hard); border-radius: 50%;
    transition: background-color .15s ease, color .15s ease;
  }
  .job[open] summary::after { content: "\2212"; background: var(--signal); color: #140a05; border-color: var(--signal); }
  .job-links { list-style: none; margin: 0; padding: 0 1.3rem 1.2rem 3.4rem; }
  .job-links a {
    display: grid; grid-template-columns: 7.5rem 1fr; gap: .8rem; align-items: baseline;
    padding: .55rem 0; text-decoration: none; color: var(--ink);
    border-top: 1px solid var(--rule-2);
  }
  .job-label {
    font-family: var(--mono); font-size: .64rem; font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3);
  }
  .job-title { font-size: .96rem; }
  .job-links a:hover .job-title { color: var(--signal); }

  /* ---- latest ---- */
  .latest-head {
    display: flex; flex-wrap: wrap; gap: .6rem 1.5rem;
    align-items: flex-end; justify-content: space-between;
  }
  .latest-count { font-family: var(--mono); font-size: .7rem; color: var(--ink-3); letter-spacing: .04em; }
  .latest { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .latest a {
    display: grid; grid-template-columns: 7.5rem 1fr auto; gap: .9rem; align-items: baseline;
    padding: .9rem 1.1rem; border: 1px solid var(--rule); border-radius: var(--r-sm);
    background: var(--surface); text-decoration: none; color: var(--ink);
    transition: border-color .2s ease, transform .2s ease;
  }
  .latest a:hover { border-color: rgba(255,106,43,.55); transform: translateX(4px); }
  .latest a:hover .latest-title { color: var(--signal); }
  .latest-label {
    font-family: var(--mono); font-size: .64rem; font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase; color: var(--signal);
  }
  .latest-title { font-size: .98rem; font-weight: 600; }
  .latest-date { font-family: var(--mono); font-size: .7rem; color: var(--ink-3); white-space: nowrap; }
  .latest-more { margin-top: 1.4rem; font-size: .9rem; color: var(--ink-3); }

  @media (max-width: 46rem) {
    .hero-grid { grid-template-columns: 1fr; }
    .job-links { padding-left: 1.3rem; }
    .job-links a, .latest a { grid-template-columns: 1fr; gap: .15rem; }
    .latest-date { grid-column: 1; }
  }
</style>
